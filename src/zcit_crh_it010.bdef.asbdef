projection;
strict ( 2 );
use draft;

define behavior for ZCIT_CRH_IT010 alias RouteHdr
{
  use create;
  use update;
  use delete;

  use action optimizeRoute;

  use action Edit;
  use action Resume;
  use action Activate;
  use action Discard;
  use action Prepare;

  use association _Stops { create; with draft; }
}

define behavior for ZCIT_CRI_IT010 alias RouteItm
{
  use update;
  use delete;

  use association _Route { with draft; }
}